# Copy to apps/api/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Matches the defaults in infra/docker-compose.yml
DATABASE_URL=postgresql://erplms:erplms_dev_password@localhost:5432/erplms?schema=public
REDIS_URL=redis://localhost:6379

# The only origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops in front of the API (0 locally, 1 behind an ALB/nginx)
TRUST_PROXY=0

# Swagger UI at /api/v1/docs (defaults to true outside production)
SWAGGER_ENABLED=true

# Global API rate limit (per IP). Stricter OTP/login limits are added in M3.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional error reporting. Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Business timezone used for "today", attendance dates, cron schedules
APP_TIMEZONE=Asia/Kolkata

# Informational label for where data is stored. Production MUST be India (e.g. aws ap-south-1) for DPDP.
DATA_REGION=local
