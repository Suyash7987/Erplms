# Copy to apps/api/.env for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Local PostgreSQL. Create the role and database first (see README).
DATABASE_URL=postgresql://erplms:erplms_dev_password@localhost:5432/erplms?schema=public

# The only origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# How many proxies in front of the API set X-Forwarded-For, so req.ip is the real client IP
# (rate limits and audit logs use it). The Next.js proxy forwards that header but does not add one.
#   0 = local development (every request appears to come from the web app)
#   1 = production with a load balancer / nginx in front of the web app that sets X-Forwarded-For
# Never set it above 0 if clients can reach the web app directly: they could fake their IP.
TRUST_PROXY=0

# Global API rate limit per IP (in-memory). Stricter login limits are added in M3.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# bcrypt cost factor for password hashes (10+ in production)
BCRYPT_ROUNDS=12

# JWT signing secrets: long random values, different from each other, never committed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Secure cookies (HTTPS only). Defaults to true in production, false otherwise.
# COOKIE_SECURE=true

# Login protection: lock after N wrong passwords for M minutes; per-15-minute request budgets
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_PER_IP=100

# Business timezone used for "today", attendance dates and due dates
APP_TIMEZONE=Asia/Kolkata

# Informational label for where data is stored. Production MUST be India (e.g. aws ap-south-1) for DPDP.
DATA_REGION=local
